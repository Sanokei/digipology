{
  "name": "digipology-protocol",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "bun": "./src/http.ts",
      "default": "./dist/http.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanokei/digipology.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://digipology.com",
  "bugs": {
    "url": "https://github.com/Sanokei/digipology/issues"
  },
  "keywords": [
    "protocol",
    "websocket",
    "multiplayer",
    "tabletop",
    "digipology"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.0"
  }
}
