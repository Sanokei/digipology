{
  "name": "digipology-faces",
  "version": "0.1.0",
  "description": "Safe declarative vector face art for Digipology pieces.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanokei/digipology.git",
    "directory": "packages/faces"
  },
  "homepage": "https://digipology.com",
  "bugs": { "url": "https://github.com/Sanokei/digipology/issues" },
  "keywords": ["faces", "vector", "canvas", "svg", "digipology"],
  "devDependencies": { "@types/bun": "^1.3.0" }
}
