{
  "name": "digipology-lua",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministically budgeted, hostile-input Lua sandbox for Digipology",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./lua-api-manifest": {
      "types": "./dist/luaApiManifest.d.ts",
      "bun": "./src/luaApiManifest.ts",
      "default": "./dist/luaApiManifest.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "codegen": "bun run scripts/generate-lua-api-manifest.ts",
    "prebuild": "bun run codegen",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanokei/digipology.git",
    "directory": "packages/lua"
  },
  "homepage": "https://digipology.com",
  "bugs": {
    "url": "https://github.com/Sanokei/digipology/issues"
  },
  "keywords": [
    "lua",
    "sandbox",
    "deterministic",
    "wasm",
    "digipology"
  ],
  "dependencies": {
    "wasmoon": "1.16.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  }
}
