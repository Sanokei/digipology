---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Digipology — Make the rules. Share the table.",
  description = "A browser-native tabletop platform for creating, publishing, and playing games together.",
  pageClass = "",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/og.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1ead9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17211c" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Digipology" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Digipology — Make the rules. Share the table." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageURL} />
    <link rel="canonical" href={canonicalURL} />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("digipology-theme");
          if (savedTheme === "light" || savedTheme === "dark") {
            document.documentElement.dataset.theme = savedTheme;
          }
        } catch {}
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Digipology home">
          <span class="wordmark-die" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Digipology</span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/#loop">The loop</a>
          <a href="/#architecture">Architecture</a>
          <a href="/docs/">Docs</a>
          <a href="https://github.com/Sanokei/digipology">GitHub</a>
        </nav>

        <div class="header-actions">
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Use dark theme">
            <span class="theme-token" aria-hidden="true"></span>
            <span data-theme-label>Dark</span>
          </button>
          <details class="mobile-menu">
            <summary>Menu</summary>
            <nav aria-label="Mobile navigation">
              <a href="/#loop">The loop</a>
              <a href="/#architecture">Architecture</a>
              <a href="/docs/">Docs</a>
              <a href="https://github.com/Sanokei/digipology">GitHub</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="footer-mark" href="/">Digipology</a>
          <p>Make the rules. Share the table.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/docs/">Documentation</a>
          <a href="https://github.com/Sanokei/digipology">Source on GitHub</a>
          <a href="https://www.npmjs.com/search?q=digipology-">Packages on npm</a>
        </nav>
        <p class="footer-note">Early development. Built in the open under the MIT License.</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const current = () => root.dataset.theme ?? (media.matches ? "dark" : "light");
        const sync = () => {
          const nextIsDark = current() === "dark";
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-label", `Use ${nextIsDark ? "light" : "dark"} theme`);
            button.setAttribute("aria-pressed", String(nextIsDark));
            const label = button.querySelector("[data-theme-label]");
            if (label) label.textContent = nextIsDark ? "Light" : "Dark";
          });
        };

        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
          button.addEventListener("click", () => {
            const theme = current() === "dark" ? "light" : "dark";
            root.dataset.theme = theme;
            try { localStorage.setItem("digipology-theme", theme); } catch {}
            sync();
          });
        });
        media.addEventListener("change", sync);
        sync();
      })();
    </script>
  </body>
</html>
