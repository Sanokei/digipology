---
import { getCollection, type CollectionEntry } from "astro:content";

import { docPath, getDocNavigation } from "../lib/docs";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const navigation = getDocNavigation(await getCollection("docs"), entry.id);
const pageTitle = `${entry.data.title} — Digipology docs`;
---

<BaseLayout title={pageTitle} description={entry.data.description} pageClass="docs-page">
  <div class="shell docs-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <div class="sidebar-sticky">
        <a class="docs-kicker" href="/docs/">Field guide / v0</a>
        <nav>
          <ol>
            {navigation.docs.map((doc, index) => (
              <li>
                <a
                  href={docPath(doc.id)}
                  aria-current={doc.id === entry.id ? "page" : undefined}
                >
                  <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  {doc.data.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </aside>

    <article class="docs-article">
      <header class="docs-heading">
        <p class="eyebrow">Documentation</p>
        <h1>{entry.data.title}</h1>
        <p class="docs-deck">{entry.data.description}</p>
      </header>

      <div class="prose">
        <slot />
      </div>

      <nav class="doc-pager" aria-label="Documentation pagination">
        {navigation.previous ? (
          <a class="pager-previous" href={docPath(navigation.previous.id)}>
            <span>Previous rule</span>
            <strong>{navigation.previous.data.title}</strong>
          </a>
        ) : <span></span>}
        {navigation.next ? (
          <a class="pager-next" href={docPath(navigation.next.id)}>
            <span>Next rule</span>
            <strong>{navigation.next.data.title}</strong>
          </a>
        ) : <span></span>}
      </nav>
    </article>
  </div>
</BaseLayout>
