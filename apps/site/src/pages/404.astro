---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Digipology" description="That page is not on the table.">
  <section class="not-found shell">
    <p class="eyebrow">Rule 404</p>
    <h1>That piece is<br />not on the table.</h1>
    <p>The page may have moved, or the rule has not been written yet.</p>
    <a class="button button-primary" href="/">Return to the table</a>
  </section>
</BaseLayout>
