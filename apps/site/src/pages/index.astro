---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowUpRight from "../components/ArrowUpRight.astro";
import "../styles/landing.css";

const games = [
  { slug: "first-deal", title: "First Deal", kind: "A classic deck. Endless possibilities.", color: "#e88956" },
  { slug: "dice-dash", title: "Dice Dash", kind: "A little luck. A friendly rivalry.", color: "#e5b346" },
  { slug: "zone-runner", title: "Zone Runner", kind: "Find your path. Make your move.", color: "#5b926d" },
];
---

<BaseLayout pageClass="landing-page" title="Digipology — Board games. Better together." description="Create your own board games, find a table, and play with friends in your browser. A good idea deserves a game night.">
  <section class="welcome-hero shell" aria-labelledby="welcome-title">
    <img class="welcome-hero__art" src="/art/tabletop-world.webp" alt="" width="1672" height="941" fetchpriority="high" />
    <div class="welcome-hero__shade"></div>
    <div class="welcome-hero__copy">
      <p class="welcome-eyebrow"><span aria-hidden="true"></span>The table is open</p>
      <h1 id="welcome-title">Digipology</h1>
      <p class="welcome-hero__headline">Big ideas.<br /><em>Great game nights.</em></p>
      <p class="welcome-hero__lede">Make a game that only you could dream up. Or find a table, invite your people, and see where the dice take you.</p>
      <div class="welcome-actions"><a class="welcome-button" href="https://play.digipology.com">Find a game <ArrowUpRight /></a><a class="welcome-button welcome-button--quiet" href="https://play.digipology.com/create">Make a game</a></div>
      <p class="welcome-hero__note">No downloads. Just one more round.</p>
    </div>
    <div class="welcome-hero__seal" aria-hidden="true"><span>Bring your</span><strong>game face.</strong><i>✺</i></div>
  </section>

  <div class="welcome-facts shell" aria-label="Ways to play"><span>Cards, dice, and a little imagination</span><i aria-hidden="true">✺</i><span>Made in your browser</span><i aria-hidden="true">✺</i><span>Better with your people</span></div>

  <section class="welcome-games shell" aria-labelledby="games-title">
    <div class="welcome-section-heading"><div><p class="welcome-eyebrow">Pull up a chair</p><h2 id="games-title">Your next round starts here.</h2></div><a class="welcome-text-link" href="https://play.digipology.com">Explore the tables <ArrowUpRight /></a></div>
    <div class="welcome-game-grid">{games.map((game) => <a class="welcome-game" href={`https://play.digipology.com/games/${game.slug}`}>
      <div class="welcome-game__art" style={`--game-color:${game.color}`}><img src={`/art/${game.slug}.webp`} alt={`${game.title} illustrated game artwork`} width="1024" height="1536" loading="lazy" /><span class="welcome-game__arrow"><ArrowUpRight /></span></div>
      <div class="welcome-game__meta"><h3>{game.title}</h3><span>2–4 players</span></div><p>{game.kind}</p>
    </a>)}</div>
  </section>

  <section class="welcome-create shell" id="loop" aria-labelledby="create-title">
    <div class="welcome-create__copy"><p class="welcome-eyebrow">For the “what if?” people</p><h2 id="create-title">Your idea.<br />Your rules.<br /><em>Your table.</em></h2><p>A race through a tiny kingdom. A card game with a ridiculous twist. That thing you keep explaining to your friends. Give it a place to play.</p><a class="welcome-button" href="https://play.digipology.com/create">Make something worth a rematch <ArrowUpRight /></a></div>
    <ol class="welcome-steps"><li><span>01</span><div><h3>Start with a spark.</h3><p>Describe your game or build it in the visual editor. Bring cards, dice, pieces, and your own rules to the table.</p></div></li><li><span>02</span><div><h3>Play it. Change it. Play again.</h3><p>Try the rules in the editor, move the pieces around, and invite a little constructive chaos.</p></div></li><li><span>03</span><div><h3>Save your friends a seat.</h3><p>Publish your game, open a table, and send an invite. They join right in the browser.</p></div></li></ol>
    <span class="welcome-create__asterisk" aria-hidden="true">✺</span>
  </section>

  <section class="welcome-together shell" id="architecture" aria-labelledby="together-title"><div class="welcome-together__heading"><p class="welcome-eyebrow">Less setup. More “your turn.”</p><h2 id="together-title">A good game<br />brings people together.</h2><p>Digipology keeps the table in your browser, so your game night can get on with being a game night.</p><a class="welcome-text-link" href="/docs/playing/">How to join the fun <ArrowUpRight /></a></div><div class="welcome-together__list"><article><ArrowUpRight /><div><h3>Send a link. Save a seat.</h3><p>Guests can join a private table with a name and an invite. No account needed to play with friends.</p></div></article><article><span aria-hidden="true">◈</span><div><h3>A real shared table.</h3><p>Shuffle, draw, roll, flip, and move pieces together. Everyone gets the same deal.</p></div></article><article><span aria-hidden="true">✺</span><div><h3>Leave room for your imagination.</h3><p>Make the tabletop game you want to play, from a quick card game to your next big idea.</p></div></article></div></section>

  <section class="welcome-closing shell"><span aria-hidden="true">✺</span><div><p class="welcome-eyebrow">Your move</p><h2>Make tonight a game night.</h2></div><a class="welcome-button" href="https://play.digipology.com">Take a seat <ArrowUpRight /></a></section>
</BaseLayout>
