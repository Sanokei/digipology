{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "digipology-play",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "play.digipology.com", "custom_domain": true }
  ],
  // SESSION_SECRET and AI_API_KEY are Wrangler secrets configured out of band:
  // `wrangler secret put SESSION_SECRET` and `wrangler secret put AI_API_KEY`.
  // AI_API_KEY is optional only for explicitly configured keyless endpoints.
  // Never add either secret to `vars`.
  "vars": {
    "PUBLIC_ORIGIN": "https://play.digipology.com",
    "EMAIL_FROM": "noreply@digipology.com",
    "AI_DAILY_REQUEST_CAP": "50",
    "AI_PROVIDER_PROFILE": "openai-compatible",
    "AI_MODEL": "",
    // Set an explicit endpoint and account-enabled model. Blank means unconfigured,
    // even if a key exists. See docs/runbooks/ai-provider.md; no implicit localhost.
    "AI_BASE_URL": "",
    // Raster jobs use an explicit account-enabled image model; no SVG/stock fallback.
    // A blank image base reuses AI_BASE_URL when that service supports images/generations.
    "AI_IMAGE_MODEL": "",
    "AI_IMAGE_BASE_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digipology",
      "database_id": "07fcc483-3234-4f58-96f6-00f0cc864281",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "digipology-releases"
    }
  ],
  // The sender domain must first be onboarded with
  // `wrangler email sending enable digipology.com`.
  "send_email": [{ "name": "EMAIL" }],
  // EMAIL_DEV_MODE is intentionally absent. Set it only in an uncommitted
  // `.dev.vars` while running `wrangler dev`.
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
