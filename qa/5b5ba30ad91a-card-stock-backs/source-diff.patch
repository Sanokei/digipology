diff --git a/apps/web/src/scene/cardArtworkCanvas.test.ts b/apps/web/src/scene/cardArtworkCanvas.test.ts
new file mode 100644
index 0000000..142de13
--- /dev/null
+++ b/apps/web/src/scene/cardArtworkCanvas.test.ts
@@ -0,0 +1,57 @@
+import { expect, test } from "bun:test";
+import { cardStockProfile } from "./cardStock";
+import { containCardBackImage, drawPieceArtwork } from "./pieceArtworkCanvas";
+
+test("game back images retain the whole source and aspect ratio inside portrait or landscape windows", () => {
+  const window = { x: 18, y: 18, width: 476, height: 580 };
+  for (const [width, height] of [[1024, 1536], [1600, 900], [512, 736]]) {
+    const contained = containCardBackImage(width!, height!, window);
+    expect(contained.x).toBeGreaterThanOrEqual(window.x - 1e-8);
+    expect(contained.y).toBeGreaterThanOrEqual(window.y - 1e-8);
+    expect(contained.x + contained.width).toBeLessThanOrEqual(window.x + window.width + 1e-8);
+    expect(contained.y + contained.height).toBeLessThanOrEqual(window.y + window.height + 1e-8);
+    expect(contained.width / contained.height).toBeCloseTo(width! / height!, 8);
+  }
+});
+
+function recorder() {
+  const text: string[] = []; const images: unknown[][] = []; const clips: unknown[][] = []; let latestPath: unknown[] = [];
+  const target: Record<string, unknown> = {
+    createLinearGradient: () => ({ addColorStop() {} }),
+    measureText: (value: string) => ({ width: value.length * 10 }),
+    roundRect: (...values: unknown[]) => { latestPath = values; }, clip: () => clips.push(latestPath),
+    drawImage: (...values: unknown[]) => images.push(values), fillText: (value: string) => text.push(value),
+  };
+  const context = new Proxy(target, { get: (object, key) => object[String(key)] ?? (() => undefined) }) as unknown as CanvasRenderingContext2D;
+  return { context, text, images, clips };
+}
+
+test("concealed bitmap backs use the stock mask and carry no count or generic monogram", () => {
+  const image = { width: 1024, height: 1536 } as unknown as CanvasImageSource;
+  const shape = cardStockProfile(0.98, 0.012, 1.4).paperShape;
+  const drawing = recorder();
+  drawPieceArtwork(drawing.context, 512, 1024, { kind: "card-back", gameTitle: "First Deal" }, { paperShape: shape, backImage: image });
+  expect(drawing.images).toHaveLength(1);
+  expect(drawing.images[0]?.[0]).toBe(image);
+  expect(drawing.images[0]).toHaveLength(5); // whole image; no source-crop rectangle
+  expect(drawing.text).toEqual(["First Deal"]);
+  expect(drawing.clips[0]).toEqual([0, 0, 512, 736, { x: 512 * shape.radiusX, y: 736 * shape.radiusY }]);
+});
+
+test("every nonempty pile and loose card share the same image window and public title", () => {
+  const image = { width: 1024, height: 1536 } as unknown as CanvasImageSource;
+  const bounds: unknown[][] = [];
+  for (const count of [52, 1, undefined]) {
+    const drawing = recorder();
+    drawPieceArtwork(drawing.context, 512, 736, { kind: "card-back", gameTitle: "First Deal", ...(count === undefined ? {} : { count }), enabled: true }, { backImage: image });
+    const rect = drawing.images[0]!;
+    expect(rect[0]).toBe(image);
+    bounds.push(rect);
+    expect(drawing.text).toEqual(["First Deal"]);
+  }
+  expect(bounds[0]).toEqual(bounds[1]); expect(bounds[1]).toEqual(bounds[2]);
+  const empty = recorder();
+  drawPieceArtwork(empty.context, 512, 736, { kind: "card-back", gameTitle: "First Deal", count: 0 }, { backImage: image });
+  expect(empty.images[0]).toEqual(bounds[0]);
+  expect(empty.text).toEqual(["First Deal", "EMPTY"]);
+});
diff --git a/apps/web/src/scene/cardBack.ts b/apps/web/src/scene/cardBack.ts
new file mode 100644
index 0000000..34452b3
--- /dev/null
+++ b/apps/web/src/scene/cardBack.ts
@@ -0,0 +1,52 @@
+import type { ArtworkCredits, ReadyDraftArtwork } from "digipology-protocol";
+import { artworkBytes, normalizeDraftArtwork } from "../editor/state/artworkData";
+
+export const CARD_BACK_PATH = "runtime/presentation/card-back.json";
+export interface CardBackDefinition {
+  readonly key: string;
+  readonly title: string;
+  readonly src: string;
+  readonly width: number;
+  readonly height: number;
+  readonly credits?: ArtworkCredits;
+  readonly issue?: string;
+}
+const parsed = new Map<string, ReadyDraftArtwork>();
+
+export function readCardBackArtwork(content: string): ReadyDraftArtwork {
+  const cached = parsed.get(content);
+  if (cached) return cached;
+  if (content.length > 720_000) throw new Error("This card-back file is too large.");
+  let value: unknown;
+  try { value = JSON.parse(content); } catch { throw new Error("This card-back file could not be read."); }
+  const raw = value as { kind?: unknown; version?: unknown; artwork?: unknown } | null;
+  const artwork = raw?.kind === "digipology-card-back" && raw.version === 1 ? normalizeDraftArtwork(raw.artwork) : undefined;
+  if (artwork?.status !== "ready") throw new Error("The saved card-back image is damaged. Replace it with a complete raster image.");
+  // Back packages are public release assets; never retain a private upload filename.
+  const clean: ReadyDraftArtwork = { status: "ready", info: artwork.info, dataUrl: artwork.dataUrl };
+  if (parsed.size >= 6) parsed.delete(parsed.keys().next().value!);
+  parsed.set(content, clean);
+  return clean;
+}
+
+export function cardBackPackage(artwork: ReadyDraftArtwork): string {
+  artworkBytes(artwork);
+  const content = JSON.stringify({ kind: "digipology-card-back", version: 1, artwork: { status: "ready", info: artwork.info, dataUrl: artwork.dataUrl } }, null, 2);
+  readCardBackArtwork(content);
+  return content;
+}
+
+/** Public game branding only; this selection never sees a concealed card's identity. */
+export function cardBackForGame(title: string | null, content?: string | null): CardBackDefinition {
+  const name = title?.trim() || "Your game";
+  let issue: string | undefined;
+  if (content) {
+    try {
+      const art = readCardBackArtwork(content);
+      return { key: art.info.sha256, title: name, src: art.dataUrl, width: art.info.width, height: art.info.height, credits: art.info.credits };
+    } catch (error) { issue = error instanceof Error ? error.message : "The card-back image could not be read."; }
+  }
+  const known: Record<string, string> = { "first deal": "first-deal", "dice dash": "dice-dash", "zone runner": "zone-runner" };
+  const art = known[name.toLowerCase()] ?? "tabletop-world";
+  return { key: `builtin-back:${art}:1`, title: name, src: `/art/${art}.webp`, width: art === "tabletop-world" ? 1672 : 1024, height: art === "tabletop-world" ? 941 : 1536, ...(issue ? { issue } : {}) };
+}
diff --git a/apps/web/src/scene/cardBackImages.test.ts b/apps/web/src/scene/cardBackImages.test.ts
new file mode 100644
index 0000000..34035ed
--- /dev/null
+++ b/apps/web/src/scene/cardBackImages.test.ts
@@ -0,0 +1,33 @@
+import { expect, test } from "bun:test";
+import { cardBackForGame } from "./cardBack";
+import { retryCardBackImage, watchCardBackImage } from "./cardBackImages";
+
+test("shared image loading retries a failed asset and drops late callbacks after its final consumer leaves", () => {
+  const original = Object.getOwnPropertyDescriptor(globalThis, "Image");
+  const created: FakeImage[] = [];
+  class FakeImage {
+    naturalWidth = 1024; naturalHeight = 1536; decoding = ""; src = "";
+    onload: (() => void) | null = null; onerror: (() => void) | null = null;
+    constructor() { created.push(this); }
+  }
+  Object.defineProperty(globalThis, "Image", { configurable: true, value: FakeImage });
+  const first: string[] = [], second: string[] = [];
+  let a: (() => void) | undefined, b: (() => void) | undefined;
+  try {
+    const back = cardBackForGame("First Deal");
+    a = watchCardBackImage(back, (state) => first.push(state.status));
+    b = watchCardBackImage(back, (state) => second.push(state.status));
+    expect(created).toHaveLength(1); created[0]!.onerror!();
+    expect(first.at(-1)).toBe("failed"); expect(second.at(-1)).toBe("failed");
+    retryCardBackImage(back); expect(created).toHaveLength(2);
+    expect(first.at(-1)).toBe("loading"); created[1]!.onload!();
+    expect(first.at(-1)).toBe("ready"); expect(second.at(-1)).toBe("ready");
+    const late = created[1]!.onload!; a(); a = undefined; b(); b = undefined;
+    const count = first.length + second.length; late();
+    expect(first.length + second.length).toBe(count);
+    a = watchCardBackImage(back, () => {}); expect(created).toHaveLength(3);
+  } finally {
+    a?.(); b?.();
+    if (original) Object.defineProperty(globalThis, "Image", original); else Reflect.deleteProperty(globalThis, "Image");
+  }
+});
