", \"rank\": \"3\", \"suit\": \"spades\", \"label\": \"3 of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_43\", \"definitionId\": \"standard_v2_spades_4\", \"rank\": \"4\", \"suit\": \"spades\", \"label\": \"4 of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_44\", \"definitionId\": \"standard_v2_spades_5\", \"rank\": \"5\", \"suit\": \"spades\", \"label\": \"5 of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_45\", \"definitionId\": \"standard_v2_spades_6\", \"rank\": \"6\", \"suit\": \"spades\", \"label\": \"6 of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_46\", \"definitionId\": \"standard_v2_spades_7\", \"rank\": \"7\", \"suit\": \"spades\", \"label\": \"7 of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_47\", \"definitionId\": \"standard_v2_spades_8\", \"rank\": \"8\", \"suit\": \"spades\", \"label\": \"8 of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_48\", \"definitionId\": \"standard_v2_spades_9\", \"rank\": \"9\", \"suit\": \"spades\", \"label\": \"9 of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_49\", \"definitionId\": \"standard_v2_spades_10\", \"rank\": \"10\", \"suit\": \"spades\", \"label\": \"10 of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_50\", \"definitionId\": \"standard_v2_spades_j\", \"rank\": \"J\", \"suit\": \"spades\", \"label\": \"Jack of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_51\", \"definitionId\": \"standard_v2_spades_q\", \"rank\": \"Q\", \"suit\": \"spades\", \"label\": \"Queen of Spades\", \"color\": \"#ede7d6\"},\u000a    {\"entityId\": \"card_52\", \"definitionId\": \"standard_v2_spades_k\", \"rank\": \"K\", \"suit\": \"spades\", \"label\": \"King of Spades\", \"color\": \"#ede7d6\"}\u000a  ]\u000a}","contentHash":"sha256:fef6d9661641563edfc017e0dbc348e4c196a8e4379f9e5755715e03de620fa7","path":"runtime/cards.json"},{"byteLength":1263,"content":"# First Deal\u000a\u000aA shared standard-deck card table for two to four people. First Deal is a sandbox: agree on a card game with your friends; this release does not award a winner automatically.\u000a\u000a## The deck\u000a\u000aThe deck has 52 distinct cards and no jokers. A fresh, unshuffled deck groups Clubs, Diamonds, Hearts, then Spades, with Ace, 2 through 10, Jack, Queen, and King in each suit.\u000a\u000a## Set up\u000a\u000aShuffle the deck and have each player use Draw card to take the number of cards your chosen rules require. A drawn card goes into that player's private hand. Inspect a card to read its identity; other players do not see that private hand in the official client.\u000a\u000a## Play and reveal\u000a\u000aSelect a hand card to inspect it. Drag a card onto the table, or open its actions and choose Play to table. The deck sits left of the central play area, so a card played to the center stays visible. Cards keep their face-down state when played. Open a table card's actions and choose Flip when your rules call for revealing it. A face-down table card's identity stays hidden in its context menu and inspector.\u000a\u000a## Finish\u000a\u000aUse the victory conditions of the game your group agreed on. Leaving a table and ending the table are separate actions; only the current host can end it for everyone.\u000a","contentHash":"sha256:68515aca2418c543e44bcfd56d22a812e8f61ccdf09a489a47541277f0a6a44e","path":"runtime/rules.md"}],"formatVersion":1,"gameId":"draft_ember_cards_transport","initialSnapshot":{"formatVersion":1,"kernelVersion":1,"releaseId":"draft_ember_cards_transport_1","sequence":0,"state":{"entities":{"card_01":{"components":{"card":{"definitionId":"standard_v2_clubs_a","faceUp":false},"flippable":{"flipped":false},"grabbable":{"enabled":true,"heldBy":null},"transform":{"position":{"x":0,"y":0,"z":0},"rotation":{"w":1,"x":0,"y":0,"z":0},"scale":{"x":1,"y":1,"z":1}}},"id":"card_01"},"card_02":{"components":{"card":{"definitionId"