+import { expect, test } from "bun:test";
+import type { ReadyDraftArtwork } from "digipology-protocol";
+import { rasterPng } from "../../../../packages/protocol/src/raster.fixture";
+import { artworkDataUrl, artworkHash } from "../editor/state/artworkData";
+import { createCardGameEditorDraft, createDiceGameEditorDraft, rebuildDraftIntegrity } from "../editor/state/bundle";
+import { attachCardBack } from "../editor/state/cardBack";
+import { updateScript } from "../editor/state/scripts";
+import { artworkJobsReady, artworkNeedsAutomaticReview, initialArtworkGeneration, selectedDraftImage } from "./model";
+
+function localRaster(width: number, height: number): ReadyDraftArtwork {
+  const bytes = rasterPng(width, height);
+  return { status: "ready", dataUrl: artworkDataUrl(bytes, "image/png"), info: { formatVersion: 1, contentType: "image/png", width, height, sha256: artworkHash(bytes), credits: { artist: "Local serialization fixture", license: "Test", sourceUrl: "" } } };
+}
+
+test("legacy manually selected cover and distinct back remain selected when generation metadata is added", () => {
+  const draft = createCardGameEditorDraft("existing-manual", "2026-10-29T00:00:00.000Z");
+  draft.artwork = localRaster(4, 6);
+  const back = localRaster(6, 9);
+  attachCardBack(draft, back); rebuildDraftIntegrity(draft);
+  const state = structuredClone(draft.bundle.initialSnapshot);
+  draft.artworkGeneration = initialArtworkGeneration(draft);
+  expect(artworkJobsReady(draft)).toBe(true);
+  expect(selectedDraftImage(draft, "cover")?.info.sha256).toBe(draft.artwork.info.sha256);
+  expect(selectedDraftImage(draft, "card-back")?.info.sha256).toBe(back.info.sha256);
+  expect(draft.bundle.initialSnapshot).toEqual(state);
+});
+
+test("a prior image does not count as a finished replacement or stand in for missing selected bytes", () => {
+  const draft = createDiceGameEditorDraft("pending-image", "2026-10-29T00:00:00.000Z");
+  draft.artwork = localRaster(4, 6); draft.artworkGeneration = initialArtworkGeneration(draft);
+  expect(draft.artworkGeneration.jobs.cardBack.status).toBe("not-needed");
+  expect(artworkJobsReady(draft)).toBe(true);
+  draft.artworkGeneration.jobs.cover.status = "failed";
+  expect(artworkJobsReady(draft)).toBe(false);
+  draft.artworkGeneration.jobs.cover.status = "ready";
+  delete draft.artwork;
+  expect(artworkJobsReady(draft)).toBe(false);
+});
+
+test("artwork completion checks its exact manifest without launching checks on every unrelated rule edit", () => {
+  const draft = createCardGameEditorDraft("art-check-scope", "2026-10-29T00:00:00.000Z");
+  draft.artwork = localRaster(4, 6); attachCardBack(draft, localRaster(6, 9)); rebuildDraftIntegrity(draft);
+  draft.artworkGeneration = initialArtworkGeneration(draft);
+  expect(artworkNeedsAutomaticReview(draft)).toBe(false);
+  draft.artworkGeneration.reviewManifestHash = draft.bundle.integrity.manifestHash;
+  expect(artworkNeedsAutomaticReview(draft)).toBe(true);
+  const file = draft.bundle.files.find((file) => file.path.endsWith(".lua"))!;
+  updateScript(draft, file.path, file.content + "\n-- User is still editing rules");
+  rebuildDraftIntegrity(draft);
+  expect(artworkNeedsAutomaticReview(draft)).toBe(false);
+});
diff --git a/apps/web/src/artwork/model.ts b/apps/web/src/artwork/model.ts
new file mode 100644
index 0000000..d868ac8
--- /dev/null
+++ b/apps/web/src/artwork/model.ts
@@ -0,0 +1,51 @@
+import type { ReadyDraftArtwork, ArtPurpose, ArtJobKey, GameArtDirection, ArtworkGeneration, GeneratedArtwork, ArtworkDraftReview } from "digipology-protocol";
+import type { ApiResult, ReleaseBundleDto } from "digipology-protocol/http";
+import type { EditorDraft } from "../editor/state/types";
+import type { CanonicalGameState } from "digipology-kernel";
+import { CARD_BACK_PATH, readCardBackArtwork } from "../scene/cardBack";
+export type { ArtPurpose, ArtJobKey, GameArtDirection, ArtworkGeneration, ArtworkGenerationJob, GeneratedArtwork } from "digipology-protocol";
+export type ArtworkDraft = EditorDraft;
+export type ArtworkReviewResult = ArtworkDraftReview;
+export interface ArtworkApi {
+  generateArtDirection(input: { title: string; rulebook: string }): Promise<ApiResult<GameArtDirection>>;
+  generateDraftArtwork(input: { draftId: string; title: string; purpose: ArtPurpose; direction: GameArtDirection; revision: number }): Promise<ApiResult<GeneratedArtwork>>;
+  reviewArtworkDraft?(bundle: ReleaseBundleDto): Promise<ApiResult<ArtworkReviewResult>>;
+}
+export interface PreparedResult { original: GeneratedArtwork; artwork: ReadyDraftArtwork }
+export const ART_PURPOSES: readonly ArtPurpose[] = ["cover", "card-back"];
+export const jobKey = (purpose: ArtPurpose): ArtJobKey => purpose === "cover" ? "cover" : "cardBack";
+export const purposeLabel = (purpose: ArtPurpose): string => purpose === "cover" ? "Cover" : "Card back";
+
+export function artworkScope(draft: EditorDraft) {
+  const entities = Object.values((draft.bundle.initialSnapshot.state as CanonicalGameState).entities);
+  const decks = entities.filter((entity) => entity.components.deck !== undefined).length;
+  return { needsBack: decks > 0 || entities.some((entity) => entity.components.card !== undefined), multipleDecks: decks > 1 };
+}
+
+export function initialArtworkGeneration(draft: EditorDraft): ArtworkGeneration {
+  const cover = selectedDraftImage(draft, "cover"), back = selectedDraftImage(draft, "card-back");
+  return { version: 1, sourceManifestHash: draft.bundle.integrity.manifestHash, direction: null,
+    jobs: { cover: { status: cover ? "ready" : "pending", revision: 0, ...(cover ? { outputSha256: cover.info.sha256 } : {}) },
+      cardBack: { status: back ? "ready" : artworkScope(draft).needsBack ? "pending" : "not-needed", revision: 0, ...(back ? { outputSha256: back.info.sha256 } : {}) } } };
+}
+
+export function selectedDraftImage(draft: EditorDraft, purpose: ArtPurpose): ReadyDraftArtwork | undefined {
+  if (purpose === "cover") return draft.artwork?.status === "ready" ? draft.artwork : undefined;
+  const content = draft.bundle.files.find((file) => file.path === CARD_BACK_PATH)?.content;
+  try { return content ? readCardBackArtwork(content) : undefined; } catch { return undefined; }
+}
+
+export function artworkJobsReady(draft: EditorDraft): boolean {
+  const generation = draft.artworkGeneration;
+  return !!generation && ART_PURPOSES.every((purpose) => {
+    const job = generation.jobs[jobKey(purpose)];
+    if (job.status === "not-needed") return purpose === "card-back" && !artworkScope(draft).needsBack;
+    const selected = selectedDraftImage(draft, purpose);
+    return job.status === "ready" && !!selected && job.outputSha256 === selected.info.sha256;
+  });
+}
+
+export function artworkNeedsAutomaticReview(draft: EditorDraft): boolean {
+  return artworkJobsReady(draft) && draft.artworkGeneration?.reviewManifestHash === draft.bundle.integrity.manifestHash &&
+    draft.generationReview?.manifestHash !== draft.bundle.integrity.manifestHash;
+}
diff --git a/apps/web/src/artwork/prepareGeneratedArtwork.ts b/apps/web/src/artwork/prepareGeneratedArtwork.ts
new file mode 100644
index 0000000..f959ef0
--- /dev/null
+++ b/apps/web/src/artwork/prepareGeneratedArtwork.ts
@@ -0,0 +1,29 @@
+import { inspectRasterImage, type ReadyDraftArtwork } from "digipology-protocol";
+import { artworkHash, prepareArtwork } from "../editor/state/artwork";
+import { SOURCE_LIMIT } from "../editor/state/artworkData";
+import type { ArtPurpose, GeneratedArtwork } from "./model";
+import { assertVisibleRasterSignal } from "./rasterSignal";
+
+/** Treat the API's image bytes as untrusted until admission and actual decoding. */
+export async function prepareGeneratedArtwork(raw: GeneratedArtwork, purpose: ArtPurpose): Promise<ReadyDraftArtwork> {
+  if (!raw || typeof raw.dataUrl !== "string" || !Number.isSafeInteger(raw.byteLength) || raw.byteLength <= 0 || raw.byteLength > SOURCE_LIMIT ||
+      typeof raw.originalSha256 !== "string" || !/^sha256:[a-f0-9]{64}$/.test(raw.originalSha256)) throw new Error("The artwork response did not contain a complete original image. Retry this image; your game is preserved.");
+  if (raw.dataUrl.length > SOURCE_LIMIT * 4 / 3 + 128) throw new Error("The generated image exceeds the original-image budget. Your rules are preserved.");
+  const match = /^data:(image\/(?:png|jpeg|webp));base64,([A-Za-z0-9+/]+={0,2})$/.exec(raw.dataUrl);
+  if (!match || match[1] !== raw.contentType) throw new Error("The generated image format does not match its bytes.");
+  let decoded: string;
+  try { decoded = atob(match[2]!); } catch { throw new Error("The generated image bytes could not be read. Retry this image."); }
+  const bytes = Uint8Array.from(decoded, (character) => character.charCodeAt(0));
+  const header = inspectRasterImage(bytes);
+  if (!header || header.contentType !== raw.contentType || header.width !== raw.width || header.height !== raw.height ||
+      bytes.length !== raw.byteLength || artworkHash(bytes) !== raw.originalSha256) {
+    throw new Error("The generated image is incomplete or changed. Retry this image; your game is preserved.");
+  }
+  if (header.width > 8192 || header.height > 8192 || header.width * header.height > 16_000_000 || header.width < 256 || header.height < 256) throw new Error("The generated image dimensions exceed the preparation budget. Retry this image.");
+  const file = new File([bytes], `${purpose}.${raw.contentType.split("/")[1]}`, { type: raw.contentType });
+  await assertVisibleRasterSignal(file);
+  const artwork = await prepareArtwork(file, raw.credits, purpose === "card-back" ? "contain" : "cover");
+  return { ...artwork, info: { ...artwork.info, generation: {
+    model: raw.model, promptHash: raw.promptHash, originalSha256: raw.originalSha256, generatedAt: raw.generatedAt,
+  } } };
+}
